{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-harness.local/schemas/task-envelope.schema.json",
  "title": "Harness task execution envelope",
  "type": "object",
  "required": [
    "schema_version", "task_id", "risk_tier", "intent_hash", "risk_envelope_hash",
    "allowed_paths", "forbidden_actions", "required_evidence", "required_approvals",
    "budgets", "stopping_conditions", "created_at", "integrity"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "version": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "risk_tier": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "intent_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "risk_envelope_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "allowed_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_actions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": ["merge", "deploy", "modify_branch_protection", "execute_production_change"]
      }
    },
    "required_evidence": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_approvals": { "type": "integer", "minimum": 0 },
    "budgets": {
      "type": "object",
      "required": ["warn_at_pct", "dimensions"],
      "properties": {
        "warn_at_pct": { "type": "integer", "minimum": 1, "maximum": 99 },
        "dimensions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["unit", "limit"],
            "properties": {
              "unit": { "enum": ["wall_clock_ms", "agents", "est_cost_usd"] },
              "limit": { "type": "number", "exclusiveMinimum": 0 },
              "estimated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stopping_conditions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "previous_envelope_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "amendments": { "type": "array" },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "hash"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
